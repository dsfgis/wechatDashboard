<Window x:Class="WechatDashboard.App.Views.Reminders.ReminderNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办提醒"
        Width="380"
        SizeToContent="Height"
        MaxHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#F4F6F8">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="待办提醒"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    Padding="7,2"
                    VerticalAlignment="Center"
                    Background="#FEF3C7"
                    CornerRadius="8"
                    Visibility="{Binding QueueBadgeVisibility}">
                <TextBlock Text="{Binding QueueBadgeText}"
                           FontSize="11"
                           Foreground="#92400E" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="11"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding TodoTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding TodoDescription}"
                               FontSize="12"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Visibility="{Binding DescriptionVisibility}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="11"
                   Foreground="#6B7280"
                   Text="完成后，该待办将移入已办理，相关提醒将同时取消。"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="知道了"
                    MinWidth="64"
                    Padding="10,5"
                    FontSize="12"
                    Click="Acknowledge_Click" />
            <Button Content="延后10分钟"
                    MinWidth="84"
                    Margin="6,0,0,0"
                    Padding="10,5"
                    FontSize="12"
                    Click="Snooze_Click" />
            <Button Content="完成"
                    MinWidth="64"
                    Margin="6,0,0,0"
                    Padding="10,5"
                    FontSize="12"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="Complete_Click" />
        </StackPanel>
    </Grid>
</Window>
