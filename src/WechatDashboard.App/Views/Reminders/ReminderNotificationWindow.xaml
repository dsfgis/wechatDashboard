<Window x:Class="WechatDashboard.App.Views.Reminders.ReminderNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办提醒"
        Width="500"
        SizeToContent="Height"
        MaxHeight="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="待办提醒"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="14"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="{Binding TodoTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="220"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding DescriptionVisibility}">
                    <TextBlock Text="{Binding TodoDescription}"
                               Foreground="#4B5563"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#6B7280"
                   Text="完成后，该待办将移入已办理，相关提醒将同时取消。"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="知道了"
                    MinWidth="88"
                    Padding="14,7"
                    Click="Acknowledge_Click" />
            <Button Content="延后10分钟"
                    MinWidth="110"
                    Margin="8,0,0,0"
                    Padding="14,7"
                    Click="Snooze_Click" />
            <Button Content="完成"
                    MinWidth="88"
                    Margin="8,0,0,0"
                    Padding="14,7"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="Complete_Click" />
        </StackPanel>
    </Grid>
</Window>
