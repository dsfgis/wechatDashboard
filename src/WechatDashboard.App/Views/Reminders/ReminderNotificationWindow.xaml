<Window x:Class="WechatDashboard.App.Views.Reminders.ReminderNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="380"
        SizeToContent="Height"
        MaxHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="#F4F6F8">
    <!-- 顶部贴齐标题栏，底部只留极小呼吸位：按钮区下方不再额外垫白。 -->
    <Grid Margin="12,0,12,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 卡片不再重复显示窗口标题，也不保留底部操作说明：内容本身就是全部信息。 -->
        <Border Padding="11,9,11,7"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 数量角标放进卡片内部：无排队时折叠后不占用任何高度，卡片顶部不会留白。 -->
                    <Border Padding="7,2"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Right"
                            Background="#FEF3C7"
                            CornerRadius="8"
                            Visibility="{Binding QueueBadgeVisibility}">
                        <TextBlock Text="{Binding QueueBadgeText}"
                                   FontSize="11"
                                   Foreground="#92400E" />
                    </Border>

                    <TextBlock Text="{Binding TodoTitle}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding TodoDescription}"
                               FontSize="12"
                               Foreground="#4B5563"
                               TextWrapping="Wrap"
                               Visibility="{Binding DescriptionVisibility}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="0,3,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <StackPanel.Resources>
                <!-- 提示条操作只保留图标：去掉默认按钮的灰底与描边，悬停时才给极淡反馈。 -->
                <Style x:Key="ReminderIconButton" TargetType="Button">
                    <Setter Property="Width" Value="21" />
                    <Setter Property="Height" Value="21" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Foreground" Value="#374151" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Hover"
                                        Background="Transparent"
                                        CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="#EDF1F6" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Hover" Property="Background" Value="#DEE5EE" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <!-- 详情：直接打开现有待办详情窗口。 -->
            <Button Style="{StaticResource ReminderIconButton}"
                    ToolTip="查看详情"
                    Click="Details_Click">
                <Path Width="11"
                      Height="11"
                      Data="M4,1 H11 L16,6 V19 H4 Z M11,1 V6 H16 M7,10 H13 M7,14 H13"
                      Stretch="Uniform"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Button>

            <!-- 知道了：眼睛图标表示已知晓，不改变待办状态。 -->
            <Button Style="{StaticResource ReminderIconButton}"
                    Margin="2,0,0,0"
                    ToolTip="知道了"
                    Click="Acknowledge_Click">
                <Path Width="12"
                      Height="12"
                      Data="M1,10 C4,5 7,3 10,3 C13,3 16,5 19,10 C16,15 13,17 10,17 C7,17 4,15 1,10 Z M13,10 A3,3 0 1,1 7,10 A3,3 0 1,1 13,10"
                      Stretch="Uniform"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.3"
                      StrokeLineJoin="Round" />
            </Button>

            <!-- 延后十分钟：时钟图标对应延期提醒。 -->
            <Button Style="{StaticResource ReminderIconButton}"
                    Margin="2,0,0,0"
                    ToolTip="延后10分钟"
                    Click="Snooze_Click">
                <Path Width="11"
                      Height="11"
                      Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 M12,6 V12 L16,14"
                      Stretch="Uniform"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Button>

            <!-- 完成：用蓝色描边勾作为主操作强调，不再套蓝色方块底色。 -->
            <Button Style="{StaticResource ReminderIconButton}"
                    Margin="2,0,0,0"
                    ToolTip="完成"
                    Foreground="#2563EB"
                    Click="Complete_Click">
                <Path Width="12"
                      Height="12"
                      Data="M4,12 L9,17 L20,6"
                      Stretch="Uniform"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="2.2"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
