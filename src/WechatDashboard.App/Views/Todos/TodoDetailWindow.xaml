<Window x:Class="WechatDashboard.App.Views.Todos.TodoDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办详情" Width="560" Height="600" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8"
        FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 只读信息框：外观与普通文本一致，但内容可选中、可复制 -->
        <Style x:Key="ReadOnlyInfoTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="CaretBrush" Value="#111827" />
            <Setter Property="SelectionBrush" Value="#93C5FD" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        </Style>
        <!-- 卡片：白色圆角容器，统一内边距与下边距 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- 卡片标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- 辅助说明文字 -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 紧凑按钮 -->
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- 标题行：左侧标题与置顶标记，右侧置顶按钮 -->
            <DockPanel Margin="0,0,0,12">
                <Button x:Name="PinButton" DockPanel.Dock="Right" Content="{Binding PinButtonText}" Command="{Binding TogglePinCommand}"
                        Style="{StaticResource CompactButton}" VerticalAlignment="Center"
                        ToolTip="置顶的待办始终排在待办页最上方" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="待办详情" FontSize="16" FontWeight="SemiBold" />
                    <Border x:Name="PinnedBadge" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4"
                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="已置顶" Foreground="#B45309" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- 优先级与项目同行，减少纵向占用 -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="优先级" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="项目" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}"
                              IsEnabled="{Binding IsProjectEditable}" Margin="0,4,0,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock Text="项目选项来自“关注设置 → 项目设置”。" Style="{StaticResource HintText}" Margin="0,-4,0,10" />

            <TextBlock Text="截止时间（清空日期表示无截止时间）" Style="{StaticResource FieldLabel}" />
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker SelectedDate="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateFormat="Short" MinWidth="130" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DueHours}" SelectedItem="{Binding DueHour}"
                          ItemStringFormat="{}{0:00}" Width="56" Margin="6,0,4,0" />
                <TextBlock Grid.Column="2" Text="时" VerticalAlignment="Center" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding DueMinutes}" SelectedItem="{Binding DueMinute}"
                          ItemStringFormat="{}{0:00}" Width="56" Margin="6,0,4,0" />
                <TextBlock Grid.Column="4" Text="分" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="保存待办" Command="{Binding SaveCommand}" Style="{StaticResource CompactButton}"
                        Margin="0,0,8,0" Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                <Button Content="完成" Command="{Binding CompleteCommand}" Style="{StaticResource CompactButton}" />
            </WrapPanel>

            <!-- 待办说明：可编辑备注，位于原始消息上方；点“保存说明”即可提交，也会随“保存待办”一起保存 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="SaveDescriptionButton" DockPanel.Dock="Right" Content="保存说明"
                                Command="{Binding SaveDescriptionCommand}" Style="{StaticResource CompactButton}" Margin="8,0,0,0"
                                ToolTip="提交当前详情（含待办说明），无需回到上方点击“保存待办”" />
                        <TextBlock Text="待办说明（可编辑保存）" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBox x:Name="DescriptionTextBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="160"
                             VerticalScrollBarVisibility="Auto" Padding="6" />
                    <TextBlock Text="说明保存在本地数据库中，也会随上方“保存待办”一起提交；清空后保存表示删除说明。"
                               Style="{StaticResource HintText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="复制原文" Click="CopyOriginalButton_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0"
                                    ToolTip="复制原始消息正文" />
                            <Button Content="复制全部信息" Click="CopyInfoButton_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0"
                                    ToolTip="复制待办的字段信息与原始消息" />
                        </StackPanel>
                        <TextBlock Text="{Binding OriginalMessageHeader}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBox Text="{Binding SourceInfoLine, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoTextBox}"
                             Visibility="{Binding PrimarySourceVisibility}" />
                    <TextBox Text="{Binding SenderInfoLine, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoTextBox}"
                             Visibility="{Binding PrimarySourceVisibility}" />
                    <TextBox x:Name="OriginalContentTextBox" Text="{Binding OriginalContent, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoTextBox}"
                             AcceptsReturn="True" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                             Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding CurrentReminderText}" DockPanel.Dock="Right"
                                   Foreground="#6B7280" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="提醒" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="设置提醒" Command="{Binding ScheduleReminderCommand}"
                                Style="{StaticResource CompactButton}" Margin="8,0,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePicker SelectedDate="{Binding ReminderDate, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedDateFormat="Short" MinWidth="130" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ReminderHours}"
                                      SelectedItem="{Binding ReminderHour}"
                                      ItemStringFormat="{}{0:00}" Width="56" Margin="6,0,4,0" />
                            <TextBlock Grid.Column="2" Text="时" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding ReminderMinutes}"
                                      SelectedItem="{Binding ReminderMinute}"
                                      ItemStringFormat="{}{0:00}" Width="56" Margin="6,0,4,0" />
                            <TextBlock Grid.Column="4" Text="分" VerticalAlignment="Center" />
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="延后只改变提醒时间，不改变截止时间。" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                    <WrapPanel>
                        <Button Content="延后10分钟" Command="{Binding SnoozeTenMinutesCommand}" Style="{StaticResource CompactButton}" Padding="8,4" Margin="0,0,6,0" />
                        <Button Content="延后30分钟" Command="{Binding SnoozeThirtyMinutesCommand}" Style="{StaticResource CompactButton}" Padding="8,4" Margin="0,0,6,0" />
                        <Button Content="延后1小时" Command="{Binding SnoozeOneHourCommand}" Style="{StaticResource CompactButton}" Padding="8,4" Margin="0,0,6,0" />
                        <Button Content="明天09:00" Command="{Binding SnoozeTomorrowCommand}" Style="{StaticResource CompactButton}" Padding="8,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" Foreground="#2563EB" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
