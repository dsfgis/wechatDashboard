<Window x:Class="WechatDashboard.App.Views.Todos.TodoDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办详情" Width="720" Height="680" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F4F6F8">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 只读信息框：外观与普通文本一致，但内容可选中、可复制 -->
        <Style x:Key="ReadOnlyInfoTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="CaretBrush" Value="#111827" />
            <Setter Property="SelectionBrush" Value="#93C5FD" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <DockPanel Margin="0,0,0,16">
                <Button x:Name="PinButton" DockPanel.Dock="Right" Content="{Binding PinButtonText}" Command="{Binding TogglePinCommand}"
                        Padding="16,7" VerticalAlignment="Center"
                        ToolTip="置顶的待办始终排在待办页最上方" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="待办详情" FontSize="22" FontWeight="SemiBold" />
                    <Border x:Name="PinnedBadge" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4"
                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="已置顶" Foreground="#B45309" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </DockPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="优先级" Foreground="#6B7280" />
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="状态" Foreground="#6B7280" />
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
            <TextBlock Text="项目" Foreground="#6B7280" />
            <ComboBox ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}"
                      IsEnabled="{Binding IsProjectEditable}" Margin="0,4,0,12">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="项目选项来自“关注设置 → 项目设置”。" Foreground="#9CA3AF" FontSize="12" Margin="0,-8,0,12" />
            <TextBlock Text="截止时间（清空日期表示无截止时间）" Foreground="#6B7280" />
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <DatePicker SelectedDate="{Binding DueDate, UpdateSourceTrigger=PropertyChanged}"
                            SelectedDateFormat="Short" MinWidth="150" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DueHours}" SelectedItem="{Binding DueHour}"
                          ItemStringFormat="{}{0:00}" Width="64" Margin="8,0,4,0" />
                <TextBlock Grid.Column="2" Text="时" VerticalAlignment="Center" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding DueMinutes}" SelectedItem="{Binding DueMinute}"
                          ItemStringFormat="{}{0:00}" Width="64" Margin="8,0,4,0" />
                <TextBlock Grid.Column="4" Text="分" VerticalAlignment="Center" />
            </Grid>
            <WrapPanel Margin="0,0,0,16">
                <Button Content="保存待办" Command="{Binding SaveCommand}" Padding="16,7" Margin="0,0,8,0" />
                <Button Content="完成" Command="{Binding CompleteCommand}" Padding="16,7" Margin="0,0,8,0" />
                <Button Content="查看原始消息" Command="{Binding NavigateToSourceCommand}" Padding="16,7" />
            </WrapPanel>

            <!-- 待办说明：可编辑备注，位于原始消息上方；点“保存说明”即可提交，也会随“保存待办”一起保存 -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button x:Name="SaveDescriptionButton" DockPanel.Dock="Right" Content="保存说明"
                                Command="{Binding SaveDescriptionCommand}" Padding="12,5" Margin="8,0,0,0"
                                ToolTip="提交当前详情（含待办说明），无需回到上方点击“保存待办”" />
                        <TextBlock Text="待办说明（可编辑保存）" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="DescriptionTextBox" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200"
                             VerticalScrollBarVisibility="Auto" Padding="8" />
                    <TextBlock Text="说明保存在本地数据库中，也会随上方“保存待办”一起提交；清空后保存表示删除说明。"
                               Foreground="#9CA3AF" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="复制原文" Click="CopyOriginalButton_Click" Padding="12,5" Margin="8,0,0,0"
                                    ToolTip="复制原始消息正文" />
                            <Button Content="复制全部信息" Click="CopyInfoButton_Click" Padding="12,5" Margin="8,0,0,0"
                                    ToolTip="复制待办的字段信息与原始消息" />
                        </StackPanel>
                        <TextBlock Text="原始消息（只读，可直接选中复制）" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox Text="{Binding SourceInfoLine, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoTextBox}" />
                    <TextBox Text="{Binding SenderInfoLine, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoTextBox}" />
                    <TextBox x:Name="OriginalContentTextBox" Text="{Binding OriginalContent, Mode=OneWay}" Style="{StaticResource ReadOnlyInfoTextBox}"
                             AcceptsReturn="True" MaxHeight="280" VerticalScrollBarVisibility="Auto"
                             Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="提醒" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentReminderText}" Foreground="#4B5563" Margin="0,4,0,8" />
                    <TextBlock Text="提醒时间" Foreground="#6B7280" />
                    <DockPanel Margin="0,4,0,8">
                        <Button DockPanel.Dock="Right" Content="设置提醒" Command="{Binding ScheduleReminderCommand}" Padding="12,6" Margin="8,0,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePicker SelectedDate="{Binding ReminderDate, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedDateFormat="Short" MinWidth="150" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ReminderHours}"
                                      SelectedItem="{Binding ReminderHour}"
                                      ItemStringFormat="{}{0:00}" Width="64" Margin="8,0,4,0" />
                            <TextBlock Grid.Column="2" Text="时" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="3" ItemsSource="{Binding ReminderMinutes}"
                                      SelectedItem="{Binding ReminderMinute}"
                                      ItemStringFormat="{}{0:00}" Width="64" Margin="8,0,4,0" />
                            <TextBlock Grid.Column="4" Text="分" VerticalAlignment="Center" />
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="延后只改变提醒时间，不改变截止时间。" Foreground="#6B7280" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Content="延后10分钟" Command="{Binding SnoozeTenMinutesCommand}" Margin="0,0,8,0" />
                        <Button Content="延后30分钟" Command="{Binding SnoozeThirtyMinutesCommand}" Margin="0,0,8,0" />
                        <Button Content="延后1小时" Command="{Binding SnoozeOneHourCommand}" Margin="0,0,8,0" />
                        <Button Content="明天09:00" Command="{Binding SnoozeTomorrowCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusText}" Foreground="#2563EB" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
