<Window x:Class="WechatDashboard.App.Views.Todos.DesktopCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:todoViews="clr-namespace:WechatDashboard.App.Views.Todos"
        x:Name="CalendarWindow"
        Title="桌面待办日历"
        Icon="../../Assets/AppIcon.png"
        Width="980"
        Height="620"
        MinWidth="860"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="#F7FAFC"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="CalendarSurface"
                Background="#F7FAFC"
                BorderBrush="#94A3B8"
                BorderThickness="1"
                CornerRadius="14"
                Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Background="#E2E8F0"
                        CornerRadius="13,13,0,0"
                        Padding="12,4"
                        PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="透明度" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,6,0" />
                            <Slider x:Name="OpacitySlider"
                                    Width="86"
                                    Minimum="0.55"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    Value="0.9"
                                    ValueChanged="OpacitySlider_ValueChanged"
                                    Margin="0,0,10,0" />
                            <CheckBox x:Name="DesktopEmbedCheckBox"
                                      Content="嵌入桌面"
                                      ToolTip="嵌入 Windows 桌面并锁定位置；取消勾选恢复移动"
                                      Checked="DesktopEmbedCheckBox_Changed"
                                      Unchecked="DesktopEmbedCheckBox_Changed"
                                      VerticalAlignment="Center"
                                      Foreground="#334155"
                                      Margin="0,0,12,0" />
                            <CheckBox x:Name="EdgeSnapCheckBox"
                                      Content="自动吸附"
                                      IsChecked="True"
                                      VerticalAlignment="Center"
                                      Foreground="#334155"
                                      Margin="0,0,8,0" />
                            <Button x:Name="DockButton" Content="停靠边缘" Style="{StaticResource ToolbarButtonStyle}" Click="DockButton_Click" />
                            <Button Content="隐藏" Style="{StaticResource ToolbarButtonStyle}" Click="HideButton_Click" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <todoViews:DesktopCalendarView Grid.Row="1" />

                <Border Grid.Row="2" Background="#EEF2F7" CornerRadius="0,0,13,13" Padding="12,7">
                    <TextBlock x:Name="DockStatusText" Text="未停靠" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,0,20,0" />
                </Border>
            </Grid>
        </Border>

        <Thumb x:Name="ResizeGrip" Width="22" Height="22"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" ToolTip="拖拽调整日历大小"
               AutomationProperties.Name="调整日历大小"
               DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta"
               DragCompleted="ResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 7,17 L 17,7 M 12,17 L 17,12" Stroke="#64748B" StrokeThickness="2" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Border x:Name="EdgeRevealHandle"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Background="#2563EB"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="9"
                Cursor="Hand"
                ToolTip="点击展开桌面待办日历"
                MouseLeftButtonDown="EdgeRevealHandle_MouseLeftButtonDown">
            <TextBlock x:Name="EdgeRevealGlyph"
                       Text="›"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
