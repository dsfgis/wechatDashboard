<Window x:Class="WechatDashboard.App.Views.Todos.DesktopCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="CalendarWindow"
        Title="桌面待办日历"
        Icon="../../Assets/AppIcon.png"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Opacity="0.9"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="TodoTitleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击打开待办详情" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
    <Border x:Name="CalendarSurface"
            Background="#F7FAFC"
            BorderBrush="#94A3B8"
            BorderThickness="1"
            CornerRadius="14"
            Padding="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="#E2E8F0"
                    CornerRadius="13,13,0,0"
                    Padding="12,10"
                    PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="桌面待办日历" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A" />
                        <TextBlock Text="　拖动标题栏移动；停靠后离开 2 秒自动收起" Margin="8,2,0,0" Foreground="#64748B" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="透明度" VerticalAlignment="Center" Foreground="#475569" Margin="0,0,6,0" />
                        <Slider Width="86"
                                Minimum="0.55"
                                Maximum="1"
                                TickFrequency="0.05"
                                Value="{Binding Opacity, ElementName=CalendarWindow, Mode=TwoWay}"
                                Margin="0,0,10,0" />
                        <CheckBox x:Name="EdgeSnapCheckBox"
                                  Content="自动吸附"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Foreground="#334155"
                                  Margin="0,0,8,0" />
                        <Button Content="停靠边缘" Style="{StaticResource ToolbarButtonStyle}" Click="DockButton_Click" />
                        <Button Content="隐藏" Style="{StaticResource ToolbarButtonStyle}" Click="HideButton_Click" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="‹" Command="{Binding PreviousMonthCommand}" Style="{StaticResource ToolbarButtonStyle}" FontSize="18" />
                            <Button Content="今天" Command="{Binding TodayCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="›" Command="{Binding NextMonthCommand}" Style="{StaticResource ToolbarButtonStyle}" FontSize="18" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="22" FontWeight="SemiBold" Foreground="#0F172A" />
                        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0" />
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,5">
                        <TextBlock Text="一" HorizontalAlignment="Center" Foreground="#64748B" />
                        <TextBlock Text="二" HorizontalAlignment="Center" Foreground="#64748B" />
                        <TextBlock Text="三" HorizontalAlignment="Center" Foreground="#64748B" />
                        <TextBlock Text="四" HorizontalAlignment="Center" Foreground="#64748B" />
                        <TextBlock Text="五" HorizontalAlignment="Center" Foreground="#64748B" />
                        <TextBlock Text="六" HorizontalAlignment="Center" Foreground="#DC2626" />
                        <TextBlock Text="日" HorizontalAlignment="Center" Foreground="#DC2626" />
                    </UniformGrid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" Padding="5" CornerRadius="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF" />
                                            <Setter Property="BorderBrush" Value="#E2E8F0" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter Property="Opacity" Value="0.42" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2563EB" />
                                                    <Setter Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TodoCount, StringFormat={}{0}项}" Foreground="#64748B" FontSize="10" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TodoCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding DayNumber}"
                                                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Date}"
                                                    Background="Transparent" BorderThickness="0" Padding="1"
                                                    HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="#1E293B" Cursor="Hand" />
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Margin="0,3,0,0">
                                            <ItemsControl ItemsSource="{Binding PreviewTodos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding Id}"
                                                                Style="{StaticResource TodoTitleButtonStyle}">
                                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#334155" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                <Setter Property="Foreground" Value="#94A3B8" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding MoreCount, StringFormat=还有 {0} 项…}" Foreground="#64748B" FontSize="10" Margin="2,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MoreCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding SelectedDateTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                            <TextBlock Text="点击标题查看或编辑详情" Margin="0,3,0,0" Foreground="#64748B" FontSize="12" />
                        </StackPanel>
                        <Grid>
                            <TextBlock Text="当天没有设置截止时间的待办" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTodos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding SelectedTodos}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Id}"
                                                Style="{StaticResource TodoTitleButtonStyle}">
                                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="7" Padding="8" Background="#F8FAFC">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#1E293B" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                            <Setter Property="Foreground" Value="#94A3B8" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Foreground="#64748B" FontSize="11" Margin="0,4,0,0">
                                                            <Run Text="{Binding TimeText, Mode=OneWay}"/><Run Text="　"/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="›" FontSize="20" Foreground="#64748B" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#EEF2F7" CornerRadius="0,0,13,13" Padding="12,7">
                <DockPanel>
                    <TextBlock x:Name="DockStatusText" DockPanel.Dock="Right" Text="未停靠" Foreground="#64748B" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#475569" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
        <Border x:Name="EdgeRevealHandle"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Background="#2563EB"
                BorderBrush="#BFDBFE"
                BorderThickness="1"
                CornerRadius="9"
                Cursor="Hand"
                ToolTip="点击展开桌面待办日历"
                MouseLeftButtonDown="EdgeRevealHandle_MouseLeftButtonDown">
            <TextBlock x:Name="EdgeRevealGlyph"
                       Text="›"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
