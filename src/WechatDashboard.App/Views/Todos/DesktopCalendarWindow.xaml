<Window x:Class="WechatDashboard.App.Views.Todos.DesktopCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:todoViews="clr-namespace:WechatDashboard.App.Views.Todos"
        x:Name="CalendarWindow"
        Title="桌面待办日历"
        Icon="../../Assets/AppIcon.png"
        Width="980"
        Height="620"
        MinWidth="860"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource CalendarCanvas}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="CalendarControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CalendarCanvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CalendarBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarSecondaryText}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource CalendarSelected}" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource CalendarAccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource CalendarHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="CalendarSurface"
                Background="{DynamicResource CalendarCanvas}"
                BorderBrush="{DynamicResource CalendarOuterBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        Background="{DynamicResource CalendarMutedSurface}"
                        CornerRadius="13,13,0,0"
                        Padding="12,4"
                        PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ThemeButton" Content="暗黑" Click="ThemeButton_Click"
                                    Style="{StaticResource ToolbarButtonStyle}" ToolTip="切换为暗黑主题"
                                    AutomationProperties.Name="切换日历主题" Margin="0,0,12,0" />
                            <TextBlock Text="透明度" VerticalAlignment="Center" Foreground="{DynamicResource CalendarSecondaryText}" Margin="0,0,6,0" />
                            <Slider x:Name="OpacitySlider"
                                    Width="86"
                                    Minimum="0.55"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    Value="0.9"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="日历透明度"
                                    ValueChanged="OpacitySlider_ValueChanged"
                                    Margin="0,0,10,0" />
                            <CheckBox x:Name="DesktopEmbedCheckBox" Style="{StaticResource CalendarCheckBoxStyle}"
                                      Content="嵌入桌面"
                                      ToolTip="嵌入 Windows 桌面并锁定位置；取消勾选恢复移动"
                                      Checked="DesktopEmbedCheckBox_Changed"
                                      Unchecked="DesktopEmbedCheckBox_Changed"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource CalendarText}"
                                      Margin="0,0,12,0" />
                            <Button x:Name="CloseButton" Style="{StaticResource ToolbarButtonStyle}"
                                    Click="CloseButton_Click" Margin="0" Width="30" Padding="0"
                                    ToolTip="关闭日历" AutomationProperties.Name="关闭日历">
                                <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <todoViews:DesktopCalendarView x:Name="CalendarContent" Grid.Row="1" />

                <Border Grid.Row="2" Background="{DynamicResource CalendarCanvas}" CornerRadius="0,0,13,13" Padding="12,7">
                    <TextBlock x:Name="DockStatusText" Text="未停靠" Foreground="{DynamicResource CalendarMutedText}" HorizontalAlignment="Right" Margin="0,0,20,0" />
                </Border>
            </Grid>
        </Border>

        <Thumb x:Name="ResizeGrip" Width="22" Height="22"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" ToolTip="拖拽调整日历大小"
               AutomationProperties.Name="调整日历大小"
               DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta"
               DragCompleted="ResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M 7,17 L 17,7 M 12,17 L 17,12" Stroke="{DynamicResource CalendarMutedText}" StrokeThickness="2" />
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Border x:Name="EdgeRevealHandle"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Background="{DynamicResource CalendarAccent}"
                BorderBrush="{DynamicResource CalendarRevealBorder}"
                BorderThickness="1"
                CornerRadius="9"
                Cursor="Hand"
                ToolTip="点击展开桌面待办日历"
                MouseLeftButtonDown="EdgeRevealHandle_MouseLeftButtonDown">
            <TextBlock x:Name="EdgeRevealGlyph"
                       Text="›"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
