<UserControl x:Class="WechatDashboard.App.Views.Todos.DesktopCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="CalendarView"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             UseLayoutRounding="True"
             MinWidth="620"
             MinHeight="420">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="CalendarControls.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CalendarCanvas}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CalendarBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource CalendarSecondaryText}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource CalendarSelected}" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource CalendarAccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource CalendarHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TodoTitleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击打开待办详情" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CalendarHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TodoCompletionCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CalendarCheckBoxStyle}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="勾选后完成" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="ToolTip" Value="该待办已办理" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource CalendarCanvas}"
            BorderBrush="{DynamicResource CalendarBorder}"
            BorderThickness="0"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="‹" Command="{Binding PreviousMonthCommand}" Style="{StaticResource ToolbarButtonStyle}" FontSize="18" />
                            <Button Content="今天" Command="{Binding TodayCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                            <Button Content="›" Command="{Binding NextMonthCommand}" Style="{StaticResource ToolbarButtonStyle}" FontSize="18" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding MonthTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource CalendarHeading}" />
                        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" Margin="0" />
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,2,0,9">
                        <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{DynamicResource CalendarMutedText}" />
                        <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{DynamicResource CalendarMutedText}" />
                        <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{DynamicResource CalendarMutedText}" />
                        <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{DynamicResource CalendarMutedText}" />
                        <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{DynamicResource CalendarMutedText}" />
                        <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{DynamicResource CalendarWeekend}" />
                        <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{DynamicResource CalendarWeekend}" />
                    </UniformGrid>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2" Padding="4" CornerRadius="9" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CalendarSurface}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource CalendarCellBorder}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource CalendarMutedSurface}" />
                                                    <Setter Property="Opacity" Value="0.65" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CalendarAccentBorder}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CalendarSelected}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedBorder}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource CalendarHoverBorder}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TodoCount, StringFormat={}{0}项}" Foreground="{DynamicResource CalendarMutedText}" FontSize="10" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TodoCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding DayNumber}"
                                                    Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Date}"
                                                    BorderThickness="0" Padding="3,1"
                                                    MinWidth="20" Height="18"
                                                    HorizontalAlignment="Left" FontWeight="SemiBold" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{DynamicResource CalendarText}" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CalendarHover}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource CalendarAccent}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DockPanel>
                                        <StackPanel Grid.Row="1" Margin="0,1,0,0">
                                            <ItemsControl ItemsSource="{Binding PreviewTodos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                                      Command="{Binding DataContext.CompleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      CommandParameter="{Binding}"
                                                                      Style="{StaticResource TodoCompletionCheckBoxStyle}" />
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding DataContext.OpenTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Style="{StaticResource TodoTitleButtonStyle}">
                                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource CalendarText}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource CalendarDisabledText}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding MoreCount, StringFormat=还有 {0} 项…}" Foreground="{DynamicResource CalendarMutedText}" FontSize="10" Margin="2,1,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MoreCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Border Grid.Column="1" Background="{DynamicResource CalendarSurface}" BorderBrush="{DynamicResource CalendarBorder}" BorderThickness="1" CornerRadius="12" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="当日日程" FontSize="11" Foreground="{DynamicResource CalendarAccentText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SelectedDateTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource CalendarHeading}" />
                            <TextBlock Text="点击标题查看或编辑详情" Margin="0,3,0,0" Foreground="{DynamicResource CalendarMutedText}" FontSize="12" />
                        </StackPanel>
                        <Grid>
                            <TextBlock Text="当天没有设置截止时间的待办" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource CalendarDisabledText}" TextWrapping="Wrap" TextAlignment="Center" Margin="20">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedTodos.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox x:Name="SelectedTodosList" ItemsSource="{Binding SelectedTodos}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemSurface" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource CalendarSelectedBorder}" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{DynamicResource CalendarHoverBorder}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding ProjectColor}" BorderThickness="3,0,0,0" CornerRadius="6" Padding="9" Background="{DynamicResource CalendarCanvas}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                          Command="{Binding DataContext.CompleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Style="{StaticResource TodoCompletionCheckBoxStyle}" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding DataContext.OpenTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Id}"
                                                        Style="{StaticResource TodoTitleButtonStyle}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource CalendarStrongText}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource CalendarDisabledText}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Foreground="{DynamicResource CalendarMutedText}" FontSize="11" Margin="0,4,0,0">
                                                                <Run Text="{Binding TimeText, Mode=OneWay}"/><Run Text="　"/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                            </TextBlock>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ProjectColor}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource CalendarMutedText}" FontSize="11" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="›" FontSize="20" Foreground="{DynamicResource CalendarMutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource CalendarCanvas}" BorderBrush="{DynamicResource CalendarBorder}" BorderThickness="0,1,0,0" CornerRadius="0,0,9,9" Padding="14,6">
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource CalendarMutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</UserControl>
