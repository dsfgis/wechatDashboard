<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 细滚动条：透明轨道 + 6 DIP 圆角胶囊滑块 + 无箭头，保留滚轮与点击轨道翻页。
         在 App.xaml 中合并后对全部窗口生效（消息流、关注设置、采集源设置、待办、日历等）。 -->

    <!-- 滑块：默认浅灰蓝，悬停加深，拖动最深 -->
    <Style x:Key="SlimScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="#C7D2DE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#94A3B8" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="#64748B" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#E2E8F0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 轨道翻页按钮：完全透明但仍接收点击，用于“点轨道翻一页” -->
    <Style x:Key="SlimScrollPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纵向：滑块随悬停显出的浅色轨道槽 -->
    <ControlTemplate x:Key="SlimVerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border x:Name="TrackSurface" Background="Transparent" CornerRadius="6" Margin="2,2" />
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SlimScrollPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SlimScrollThumbStyle}" Margin="3,2" MinHeight="24" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SlimScrollPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackSurface" Property="Background" Value="#EFF3F7" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 横向：与纵向同款，仅方向与翻页命令不同 -->
    <ControlTemplate x:Key="SlimHorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border x:Name="TrackSurface" Background="Transparent" CornerRadius="6" Margin="2,2" />
            <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource SlimScrollPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SlimScrollThumbStyle}" Margin="2,3" MinWidth="24" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource SlimScrollPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TrackSurface" Property="Background" Value="#EFF3F7" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 隐式样式：全局替换默认 Aero 滚动条，宽度 12 DIP（滑块可见宽度 6 DIP） -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource SlimVerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template" Value="{StaticResource SlimHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
