<Window x:Class="WechatDashboard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:local="clr-namespace:WechatDashboard.App"
        xmlns:todoViews="clr-namespace:WechatDashboard.App.Views.Todos"
        xmlns:messageViews="clr-namespace:WechatDashboard.App.Views.Messages"
        Title="IM消息看板"
        Icon="Assets/AppIcon.png"
        Height="760"
        Width="1180"
        MinHeight="640"
        MinWidth="980"
        Loaded="MainWindow_Loaded"
        StateChanged="MainWindow_StateChanged"
        Closing="MainWindow_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
        </Style>
        <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SidebarNavigationStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D1D5DB" />
        </Style>
        <Style x:Key="SidebarNavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavigationItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="#2B3748" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="Background" Value="#374151" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AlternatingRowBackground" Value="#F9FAFB" />
            <Setter Property="RowHeight" Value="34" />
        </Style>
        <!-- 行内危险操作按钮（删除）：透明底、红字、紧凑 -->
        <Style x:Key="RowDangerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- 行内次要按钮（添加关键字）：白底细边框、紧凑 -->
        <Style x:Key="RowMiniButton" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- 项目树节点：自绘三角箭头标题，展开后内容缩进，鼠标悬停高亮 -->
        <Style x:Key="ProjectTreeExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="6" Padding="6,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron" Text="&#x25B8;" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="Text" Value="&#x25BE;" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#F3F6F9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TodoMessageContentTemplate">
            <TextBlock Text="{Binding MessageContent}"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       ToolTipService.ShowDuration="60000">
                <TextBlock.ToolTip>
                    <ToolTip MaxWidth="700"
                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <TextBlock Text="{Binding MessageContent}"
                                   TextWrapping="Wrap" />
                    </ToolTip>
                </TextBlock.ToolTip>
            </TextBlock>
        </DataTemplate>

    </Window.Resources>

    <Grid Background="#F4F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#1F2937" Padding="14">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="IM消息看板" Foreground="White"
                           FontSize="18" FontWeight="SemiBold" Margin="8,4,0,20" />
                <ListBox x:Name="SidebarNavigation" DockPanel.Dock="Top" SelectedIndex="0"
                         Style="{StaticResource SidebarNavigationStyle}" ItemContainerStyle="{StaticResource SidebarNavigationItemStyle}"
                         SelectionChanged="SidebarNavigation_SelectionChanged">
                    <ListBoxItem Content="&#x9879;&#x76EE;&#x770B;&#x677F;" Tag="4" />
                    <ListBoxItem Content="日程概览" Tag="8" />
                    <ListBoxItem Content="&#x5F85;&#x529E;&#x7406;" Tag="0" />
                    <ListBoxItem Content="&#x5DF2;&#x529E;&#x7406;" Tag="1" />
                    <ListBoxItem Content="&#x6D88;&#x606F;&#x6D41;" Tag="2" />
                    <ListBoxItem Content="&#x5FAE;&#x4FE1;&#x6D88;&#x606F;" Tag="3" />
                    <ListBoxItem Content="&#x5173;&#x6CE8;&#x8BBE;&#x7F6E;" Tag="5" />
                    <ListBoxItem Content="优先级设置" Tag="10" />
                    <ListBoxItem Content="&#x91C7;&#x96C6;&#x6E90;&#x8BBE;&#x7F6E;" Tag="6" />
                    <ListBoxItem Content="&#x91C7;&#x96C6;&#x8BCA;&#x65AD;" Tag="7" />
                    <!-- 模型配置固定使用 DeepSeek，页面只维护 API Key。 -->
                    <ListBoxItem Content="模型配置" Tag="9" />
                </ListBox>
                <Button DockPanel.Dock="Top"
                        Content="桌面日历"
                        Click="DesktopCalendarButton_Click"
                        Margin="0,10,0,0"
                        Padding="12,9"
                        HorizontalContentAlignment="Left"
                        Foreground="#E5E7EB"
                        Background="#2B3748"
                        BorderBrush="#475569"
                        ToolTip="显示半透明桌面待办日历" />
                <StackPanel Visibility="Collapsed" DockPanel.Dock="Top">
                    <TextBlock Text="待办理" Foreground="#E5E7EB" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Text="已办理" Foreground="#E5E7EB" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Text="消息流" Foreground="#E5E7EB" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Text="项目" Foreground="#E5E7EB" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Text="看板" Foreground="#E5E7EB" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Text="规则" Foreground="#E5E7EB" FontSize="15" Margin="0,0,0,12" />
                    <TextBlock Text="采集诊断" Foreground="#E5E7EB" FontSize="15" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding DatabasePath}"
                           Foreground="#9CA3AF"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DatabasePath}"
                           FontSize="10" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding SelectedItem.Content, ElementName=SidebarNavigation}" FontSize="22" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="{Binding ListenerStatusText}"
                                   Margin="0,4,0,0"
                                   Foreground="#2563EB"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummaryText}"
                                   Margin="0,4,0,0"
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainContentTabs}" Value="4">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainContentTabs}" Value="6">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainContentTabs}" Value="7">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainContentTabs}" Value="9">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>
                        <Button Content="&#x5F00;&#x59CB;&#x76D1;&#x542C;" Click="StartWeChatListenerButton_Click" />
                        <Button Content="&#x505C;&#x6B62;&#x76D1;&#x542C;" Click="StopWeChatListenerButton_Click" />
                        <Button Content="&#x5237;&#x65B0;" Click="RefreshButton_Click" Margin="0,0,0,8" />
                    </WrapPanel>
                </Grid>
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainContentTabs}" Value="6">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainContentTabs}" Value="7">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel Width="104" Margin="0,0,12,8">
                            <TextBlock Text="历史范围" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox x:Name="BootstrapRangeComboBox" SelectedIndex="1">
                                <ComboBoxItem Content="7天" Tag="7d" />
                                <ComboBoxItem Content="30天" Tag="30d" />
                                <ComboBoxItem Content="全部" Tag="all" />
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="ExtractDatabaseKeyButton" Content="自动提取 Key" Click="ExtractDatabaseKeyButton_Click" VerticalAlignment="Bottom" />
                        <Button x:Name="InitLocalDatabaseButton" Content="初始化本地库" Click="InitLocalDatabaseButton_Click" VerticalAlignment="Bottom" />
                        <Button Content="刷新" Click="RefreshButton_Click" VerticalAlignment="Bottom" />
                        <Button Content="采集一次" Click="CaptureButton_Click" VerticalAlignment="Bottom" />
                        <Button Content="开始监听" Click="StartWeChatListenerButton_Click" VerticalAlignment="Bottom" />
                        <Button Content="停止监听" Click="StopWeChatListenerButton_Click" VerticalAlignment="Bottom" />
                        <Button Content="示例消息" Click="SeedButton_Click" VerticalAlignment="Bottom" />
                    </WrapPanel>
                </Border>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <UniformGrid.Style>
                    <Style TargetType="UniformGrid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=MainContentTabs}" Value="4">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="今日消息" Foreground="#6B7280" />
                        <TextBlock Text="{Binding TodayMessageCount}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="@我" Foreground="#6B7280" />
                        <TextBlock Text="{Binding MentionCount}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="待办理" Foreground="#6B7280" />
                        <TextBlock Text="{Binding PendingTodoCount}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <TextBlock Text="P0/P1" Foreground="#6B7280" />
                        <TextBlock Text="{Binding HighPriorityTodoCount}" FontSize="26" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TabControl x:Name="MainContentTabs" Grid.Row="2" SelectedIndex="4">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="待办理">
                    <todoViews:TodoPendingView DataContext="{Binding TodoFeature.Workbench}" />
                </TabItem>
                <TabItem Header="已办理">
                    <todoViews:TodoCompletedView DataContext="{Binding TodoFeature.Workbench}" />
                </TabItem>
                <TabItem Header="消息流">
                    <messageViews:MessageFeedView DataContext="{Binding TodoFeature.MessageFeed}" />
                </TabItem>
                <TabItem Header="微信消息">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="{Binding WeChatMessageStatusText}" VerticalAlignment="Center" Foreground="#4B5563" TextWrapping="Wrap" />
                            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="读取当天消息" Click="LoadTodayWeChatMessagesButton_Click" />
                                <TextBlock Text="每页" VerticalAlignment="Center" Foreground="#4B5563" Margin="0,0,4,0" />
                                <ComboBox x:Name="WeChatMessagePageSizeComboBox" Width="72" Margin="0,0,8,0" SelectedIndex="1" SelectionChanged="WeChatMessagePageSizeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="20" Tag="20" />
                                    <ComboBoxItem Content="50" Tag="50" />
                                    <ComboBoxItem Content="100" Tag="100" />
                                    <ComboBoxItem Content="200" Tag="200" />
                                </ComboBox>
                                <Button Content="首页" Click="FirstWeChatMessagesPageButton_Click" />
                                <Button Content="上一页" Click="PreviousWeChatMessagesPageButton_Click" />
                                <Button Content="下一页" Click="NextWeChatMessagesPageButton_Click" />
                                <Button Content="末页" Click="LastWeChatMessagesPageButton_Click" />
                                <TextBlock Text="跳至" VerticalAlignment="Center" Foreground="#4B5563" Margin="0,0,4,0" />
                                <TextBox x:Name="WeChatMessagePageNumberTextBox" Width="48" Text="1" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                <Button Content="跳转" Click="GoToWeChatMessagesPageButton_Click" />
                                <TextBlock Text="{Binding WeChatMessagePageText}" VerticalAlignment="Center" Foreground="#4B5563" Margin="4,0,0,0" />
                            </WrapPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding HighlightableWeChatMessages}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding SentAt}" Width="150" />
                                <DataGridTemplateColumn Header="消息内容" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <local:HighlightTextBlock ContentSegments="{Binding ContentSegments}"
                                                                      TextWrapping="Wrap"
                                                                      ToolTipService.ShowDuration="60000">
                                                <local:HighlightTextBlock.ToolTip>
                                                    <ToolTip MaxWidth="700"
                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <TextBlock Text="{Binding Content}"
                                                                   TextWrapping="Wrap" />
                                                    </ToolTip>
                                                </local:HighlightTextBlock.ToolTip>
                                            </local:HighlightTextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="群名称" Binding="{Binding ChatName}" Width="220" />
                                <DataGridTextColumn Header="发消息人" Binding="{Binding SenderName}" Width="140" />
                                <DataGridTemplateColumn Header="操作" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="转为待办" Padding="9,4"
                                                    Command="{Binding DataContext.TodoFeature.MessageFeed.ConvertToTodoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding MessageId}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="项目看板">
                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="10" Padding="16">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="项目统计" FontSize="17" FontWeight="SemiBold" Foreground="#111827" />
                                    <TextBlock Text="{Binding DashboardStatusText}" Margin="0,4,0,0" Foreground="#6B7280" TextWrapping="Wrap" />
                                </StackPanel>
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="统计维度" VerticalAlignment="Center" Foreground="#4B5563" Margin="0,0,6,8" />
                                    <ComboBox x:Name="DashboardDimensionComboBox" Width="120" SelectedIndex="0" SelectionChanged="DashboardDimensionComboBox_SelectionChanged">
                                        <ComboBoxItem Content="按项目" Tag="project" />
                                        <ComboBoxItem Content="按时间" Tag="time" />
                                        <ComboBoxItem Content="按群名" Tag="chat" />
                                    </ComboBox>
                                    <TextBlock Text="图表类型" VerticalAlignment="Center" Foreground="#4B5563" Margin="14,0,6,8" />
                                    <ComboBox x:Name="DashboardChartTypeComboBox" Width="128" SelectedIndex="0" SelectionChanged="DashboardChartTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="横向柱状图" Tag="bar" />
                                        <ComboBoxItem Content="环形占比图" Tag="pie" />
                                        <ComboBoxItem Content="趋势折线图" Tag="line" />
                                    </ComboBox>
                                </WrapPanel>
                            </DockPanel>

                            <local:DashboardChartControl ItemsSource="{Binding DashboardChartRows}"
                                                         ChartType="{Binding DashboardChartType}"
                                                         MinHeight="330" />
                        </DockPanel>
                    </Border>
                </TabItem>
                <TabItem Header="关注设置">
                    <Border Background="White" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="关注的 @ 人名字（消息中 @ 到这些名字时会高亮显示，并标记为重点关注）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="输入微信昵称或姓名，支持添加多个。添加后，消息中 @ 到这些名字时将红色高亮。" FontSize="13" Foreground="#6B7280" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="NewAliasTextBox" Width="260" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="输入微信昵称或姓名" />
                            <Button Content="添加" Click="AddAliasButton_Click" Margin="0,0,8,0" Padding="16,4" />
                            <Button Content="删除选中" Click="DeleteAliasButton_Click" Padding="16,4" />
                        </StackPanel>
                        <DataGrid x:Name="AliasesGrid" ItemsSource="{Binding Aliases}" Margin="0,0,0,16"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="80" />
                                <DataGridTextColumn Header="关注的人名字" Binding="{Binding Alias}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="说明：" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="1. 添加的名称将用于识别消息中是否 @ 到了关注的人" FontSize="13" Foreground="#4B5563" Margin="0,0,0,2" />
                        <TextBlock Text="2. 消息中 @ 到关注的人名时，该名字会以红色粗体高亮显示" FontSize="13" Foreground="#4B5563" Margin="0,0,0,2" />
                        <TextBlock Text="3. 新采集的消息将使用更新后的名单进行匹配" FontSize="13" Foreground="#4B5563" Margin="0,0,0,2" />
                        <TextBlock Text="4. 支持中文昵称、英文名等多种格式" FontSize="13" Foreground="#4B5563" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="关注群设置（按群名过滤消息）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="输入群名称，支持添加多个。默认仅显示列表中的群；勾选下方复选框可切换为排除列表中的群。留空则显示所有群。" FontSize="13" Foreground="#6B7280" Margin="0,0,0,12" />
                        <CheckBox x:Name="FollowedChatFilterModeCheckBox" Content="排除列表中的群（黑名单模式：不显示列表内群消息）" Click="FollowedChatFilterModeCheckBox_CheckedChanged" Margin="0,0,0,12" FontSize="13" ToolTip="未勾选=只显示列表内群（白名单）；勾选=排除列表内群（黑名单）" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBox x:Name="NewFollowedChatTextBox" Width="260" Margin="0,0,8,0" VerticalContentAlignment="Center" ToolTip="输入群名称" />
                            <Button Content="添加" Click="AddFollowedChatButton_Click" Margin="0,0,8,0" Padding="16,4" />
                            <Button Content="删除选中" Click="DeleteFollowedChatButton_Click" Padding="16,4" />
                        </StackPanel>
                        <DataGrid x:Name="FollowedChatsGrid" ItemsSource="{Binding FollowedChats}" Margin="0,0,0,16"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="80" />
                                <DataGridTextColumn Header="群名称" Binding="{Binding ChatName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="项目设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="先为项目选择颜色并创建项目，再展开项目为它添加多个关键字。手动待办可直接选择项目；自动待办仍按群名或消息正文中的项目关键字归属。" FontSize="13" Foreground="#6B7280" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox x:Name="NewFollowedProjectTextBox" Width="220" Margin="0,0,8,0" ToolTip="输入项目名称" />
                            <ComboBox x:Name="NewFollowedProjectColorComboBox" Width="120" ItemsSource="{Binding ProjectColors}" SelectedIndex="0" Margin="0,0,8,0" ToolTip="选择项目颜色">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="AddFollowedProjectButton" Content="添加项目" Click="AddFollowedProjectButton_Click" Padding="16,4" Margin="0" />
                        </StackPanel>
                        <!-- 项目树：每个节点是一个可折叠项目，展开后缩进展示关键字并可逐个删除 -->
                        <ItemsControl ItemsSource="{Binding FollowedProjectTree}" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource ProjectTreeExpander}" Margin="0,0,0,2">
                                        <Expander.Header>
                                            <DockPanel LastChildFill="True">
                                                <Button Style="{StaticResource RowDangerButton}" DockPanel.Dock="Right" Content="删除项目"
                                                        Click="DeleteFollowedProjectButton_Click" VerticalAlignment="Center"
                                                        ToolTip="删除该项目及其全部关键字" />
                                                <ComboBox Width="110" DockPanel.Dock="Right" Margin="0,0,4,0" VerticalAlignment="Center"
                                                          ItemsSource="{Binding DataContext.ProjectColors, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Color"
                                                          SelectedValue="{Binding Color, Mode=OneWay}"
                                                          SelectionChanged="FollowedProjectColorComboBox_SelectionChanged"
                                                          ToolTip="选择后立即保存项目颜色" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding KeywordSummary}" Foreground="#9CA3AF" FontSize="12"
                                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="18,2,0,6">
                                            <ItemsControl ItemsSource="{Binding Keywords}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FAFBFC" BorderBrush="#E5E7EB" BorderThickness="3,0,0,0"
                                                                Padding="10,5" Margin="0,2,0,0">
                                                            <DockPanel LastChildFill="True">
                                                                <Button Style="{StaticResource RowDangerButton}" DockPanel.Dock="Right" Content="删除"
                                                                        Click="DeleteFollowedProjectKeywordButton_Click" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Keyword}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBox x:Name="InlineKeywordTextBox" Width="200" ToolTip="输入要添加到该项目的关键字" />
                                                <Button Style="{StaticResource RowMiniButton}" Content="添加关键字"
                                                        Tag="{Binding ElementName=InlineKeywordTextBox}"
                                                        Click="AddInlineKeywordButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding CaptureInboxPath, StringFormat=采集目录：{0}}" FontSize="13" Foreground="#9CA3AF" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
                </TabItem>
                <TabItem Header="采集源设置">
                    <DockPanel>
                        <!-- 石化邮凭据：密码只经 DPAPI 加密保存在本机，不进入数据库或配置文件 -->
                        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="石化邮账号（IMAP）" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <TextBlock Text="账号" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <TextBox x:Name="MailAccountTextBox" Width="170" Margin="6,0,14,0" VerticalContentAlignment="Center" />
                                    <TextBlock Text="密码" Foreground="#6B7280" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="MailPasswordBox" Width="150" Margin="6,0,14,0" VerticalContentAlignment="Center" />
                                    <Button Content="保存账号" Click="SaveSinopecMailCredentialButton_Click" Padding="12,4" Margin="0,0,8,0" />
                                    <Button Content="清除" Click="ClearSinopecMailCredentialButton_Click" Padding="12,4" Margin="0,0,12,0" />
                                    <TextBlock x:Name="MailCredentialStatusText" Foreground="#6B7280" VerticalAlignment="Center" Text="尚未保存账号密码" />
                                </WrapPanel>
                                <TextBlock Foreground="#9CA3AF" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Text="密码使用 Windows DPAPI 以当前用户身份加密保存在 %LocalAppData%\WechatDashboard\Mail，不写入数据库、日志或配置文件。保存账号后，在上表勾选“石化邮（IMAP）”并点击“保存设置”才会开始采集。" />
                            </StackPanel>
                        </Border>
                        <Button DockPanel.Dock="Top" Content="保存设置" Click="SaveCaptureSourceSettingsButton_Click" HorizontalAlignment="Right" Margin="0,0,0,10" />
                        <DataGrid ItemsSource="{Binding CaptureSourceSettings}" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="140" IsReadOnly="True" />
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="130" IsReadOnly="True" />
                                <DataGridTextColumn Header="路径" Binding="{Binding Location}" Width="*" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                <TabItem Header="采集诊断">
                    <Border Background="White" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Diagnostics}"
                                      RowHeight="{x:Static sys:Double.NaN}"
                                      MinRowHeight="34"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="适配器" Binding="{Binding Adapter}" Width="180" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120" />
                                    <DataGridTextColumn Header="最近成功" Binding="{Binding LastSuccessAt}" Width="180" />
                                    <DataGridTemplateColumn Header="摘要" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Detail}"
                                                           Margin="4,6"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Detail}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Grid.Row="2" Margin="0,14,0,8">
                                <TextBlock Text="可见窗口快照" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="扫描微信窗口" Click="ScanWeChatWindowsButton_Click" />
                            </DockPanel>
                            <DataGrid Grid.Row="3" ItemsSource="{Binding WindowSnapshots}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="窗口标题" Binding="{Binding WindowTitle}" Width="220" />
                                    <DataGridTextColumn Header="采集时间" Binding="{Binding CapturedAt}" Width="170" />
                                    <DataGridTextColumn Header="文本长度" Binding="{Binding TextLength}" Width="90" />
                                    <DataGridTextColumn Header="预览" Binding="{Binding Preview}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="日程概览">
                    <todoViews:DesktopCalendarView DataContext="{Binding ScheduleOverview}" />
                </TabItem>
                <TabItem Header="模型配置">
                    <Border Background="White" Padding="24">
                        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                            <!-- 固定服务商和模型，避免要求用户填写技术参数。 -->
                            <TextBlock Text="DeepSeek 模型" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="接口：https://api.deepseek.com/chat/completions    模型：deepseek-flash"
                                       Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,20" />
                            <!-- 已保存密钥不会回填到此控件，始终只显示掩码输入。 -->
                            <TextBlock Text="API Key" Style="{StaticResource FieldLabelTextStyle}" />
                            <PasswordBox x:Name="DeepSeekApiKeyPasswordBox"
                                         Width="420"
                                         HorizontalAlignment="Left"
                                         Margin="0,0,0,12"
                                         ToolTip="填写 DeepSeek 平台的 API Key" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="保存配置" Click="SaveModelConfigButton_Click" />
                                <Button Content="清除本机密钥" Click="ClearModelConfigButton_Click" />
                            </StackPanel>
                            <!-- 开关与 API Key 分开生效：开关立即应用，密钥仍在重启后加载。 -->
                            <CheckBox x:Name="AnalyzeMessageContentCheckBox"
                                      Content="分析消息内容"
                                      Click="AnalyzeMessageContentCheckBox_Click"
                                      Margin="0,8,0,4" />
                            <!-- 明确说明智能筛选范围与模型故障时的保守回退行为。 -->
                            <TextBlock Text="开启后由大模型判断之后新入库的 @我 消息是否需要创建待办，并生成优先级和说明；低优先级或与你无关的消息仅入库，模型失败时仍按原逻辑自动创建待办。"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <!-- 状态只说明保存结果和生效时间，不宣称连接或鉴权成功。 -->
                            <TextBlock Text="{Binding ModelConfigStatusText}"
                                       Foreground="#2563EB"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,12" />
                            <TextBlock Text="API Key 使用当前 Windows 用户加密保存，不写入 SQLite。保存或清除后需重启应用。"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </TabItem>
                <!-- 优先级设置：层数与配色写 app_settings，保存后立即刷新待办、消息流与日程。 -->
                <TabItem Header="优先级设置">
                    <Border Background="White" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                                <TextBlock Text="优先级设置" FontSize="17" FontWeight="SemiBold" Foreground="#111827" />
                                <TextBlock Text="自定义优先级层数（2–6 级）与每级颜色。层数决定新建/编辑待办时可选的层级；颜色同时用于待办列表、消息流正文与日程卡片。"
                                           Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,14" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="优先级层数" VerticalAlignment="Center" Foreground="#374151" />
                                    <ComboBox Width="90" Margin="8,0,0,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding PriorityLevelSettings.LevelCountOptions}"
                                              SelectedItem="{Binding PriorityLevelSettings.LevelCount, Mode=TwoWay}"
                                              ToolTip="层数决定可选的优先级个数" />
                                    <TextBlock Text="代码固定为 P0（最高）到 P(n-1)；减少层数不会删除已有数据。"
                                               VerticalAlignment="Center" Foreground="#9CA3AF" FontSize="12" Margin="10,0,0,0" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding PriorityLevelSettings.Levels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="112" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="14" Height="14" CornerRadius="7"
                                                            Background="{Binding Color}" BorderBrush="#D1D5DB" BorderThickness="1"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Code}" Foreground="{Binding Color}"
                                                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="2" Margin="8,0,10,0" VerticalAlignment="Center"
                                                              ItemsSource="{Binding ColorOptions}"
                                                              SelectedValuePath="Color"
                                                              SelectedValue="{Binding Color, Mode=TwoWay}"
                                                              ToolTip="从预设颜色中选择">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="10" Height="10" CornerRadius="5"
                                                                            Background="{Binding Color}" Margin="0,0,6,0" />
                                                                    <TextBlock Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="3" VerticalContentAlignment="Center"
                                                             Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                             ToolTip="也可直接输入十六进制颜色，如 #D92D20" />
                                                    <TextBlock Grid.Column="4" Text="{Binding PreviewText}" Foreground="{Binding Color}"
                                                               FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="保存设置" Padding="16,4"
                                            Command="{Binding PriorityLevelSettings.SaveCommand}" />
                                    <Button Content="恢复默认（4 级）" Padding="16,4" Margin="8,0,0,0"
                                            Command="{Binding PriorityLevelSettings.ResetCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PriorityLevelSettings.StatusText}" Foreground="#2563EB"
                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Separator Margin="0,14,0,10" />
                                <TextBlock Text="说明" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="1. 层数最少 2 级、最多 6 级，保存后立即生效，无需重启。" FontSize="13" Foreground="#4B5563" Margin="0,0,0,2" />
                                <TextBlock Text="2. 颜色同时作用于待办卡片、已办理列表、消息流正文与日程卡片，保证同一层级只有一种颜色。" FontSize="13" Foreground="#4B5563" Margin="0,0,0,2" />
                                <TextBlock Text="3. 减少层数只改变显示与可选项：超出层数的历史待办按最低一级显示，原始值仍保存在库中，调回层数即可恢复。" FontSize="13" Foreground="#4B5563" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
